						"description": "Melihat detail lengkap satu laporan berdasarkan ID."
					}
				},
				{
					"name": "Update Status Laporan (Relawan/Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"proses\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/laporan/1/status",
							"host": ["{{base_url}}"],
							"path": ["api", "laporan", "1", "status"]
						},
						"description": "Memperbarui status laporan (aktif / proses / selesai). Khusus Relawan dan Admin."
					}
				}
			]
		},
