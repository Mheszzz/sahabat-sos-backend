							"mode": "raw",
							"raw": "{\n  \"nama\": \"Budi Santoso Updated\",\n  \"kategori_user\": \"tunarungu\",\n  \"no_telp\": \"081298765432\",\n  \"alamat\": \"Jl. Merdeka Barat No. 10, Jakarta Pusat\",\n  \"talkback\": true,\n  \"ukuran_teks\": true,\n  \"getaran\": true,\n  \"mode_kontras_sangat_tinggi\": true,\n  \"metode_komunikasi_pilihan\": \"pesan_suara_audio\"\n}"
