							"raw": "{{base_url}}/api/laporan",
							"host": ["{{base_url}}"],
							"path": ["api", "laporan"]
						},
						"description": "Mengirimkan laporan darurat baru. Mendukung upload foto (image) & rekam suara (audio)."
					}
				},
				{
					"name": "Daftar Laporan Terdekat (Relawan)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
