								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/laporan/nearby?latitude=-6.2088&longitude=106.8456&radius=5.0",
							"host": ["{{base_url}}"],
							"path": ["api", "laporan", "nearby"],
							"query": [
								{
									"key": "latitude",
									"value": "-6.2088"
								},
								{
									"key": "longitude",
									"value": "106.8456"
								},
								{
									"key": "radius",
									"value": "5.0"
								}
							]
						},
						"description": "Digunakan relawan untuk mencari laporan aktif disekitarnya berdasarkan koordinat GPS dan radius (KM)."
					}
				},
				{
					"name": "Daftar Seluruh Laporan",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/laporan?status=aktif",
							"host": ["{{base_url}}"],
							"path": ["api", "laporan"],
							"query": [
								{
									"key": "status",
									"value": "aktif"
								}
							]
						},
						"description": "Melihat daftar laporan (Pengguna: milik sendiri, Relawan/Admin: seluruh laporan)."
					}
				},
				{
					"name": "Detail Laporan",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
