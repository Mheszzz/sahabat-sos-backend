							"mode": "raw",
							"raw": "{\n  \"alamat\": \"Jl. Sudirman No. 12, Jakarta\",\n  \"no_telp\": \"081234567890\",\n  \"kategori_user\": \"tunarungu\",\n  \"catatan_medis\": \"Riwayat asma, butuh pendamping saat darurat.\",\n  \"getaran\": true,\n  \"talkback\": false,\n  \"panduan_suara\": true,\n  \"text_besar\": true\n}"
