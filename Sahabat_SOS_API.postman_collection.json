	"item": [
		{
			"name": "1. Autentikasi (Auth)",
			"item": [
				{
					"name": "Registrasi (Pengguna / Relawan)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"pengguna\",\n  \"persetujuan_privasi\": true,\n  \"no_telp\": \"081298765432\",\n  \"alamat\": \"Jl. Merdeka No. 45, Jakarta\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Mendaftarkan akun baru untuk role 'pengguna' atau 'relawan'. Wajib menyetujui persetujuan_privasi."
					}
				},
				{
					"name": "Login (Pengguna / Relawan)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"budi@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login menggunakan Email & Password khusus Pengguna dan Relawan."
					}
				},
				{
					"name": "Login Google Mobile",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"GOOGLE_ID_TOKEN_FROM_FLUTTER\",\n  \"role\": \"pengguna\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/google/mobile",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "google", "mobile"]
						},
						"description": "Verifikasi & Login menggunakan Google ID Token dari aplikasi Mobile."
					}
				},
				{
					"name": "Login Admin / Superadmin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@sahabatsos.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/admin/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "admin", "login"]
						},
						"description": "Login khusus Admin dan Superadmin untuk Web React Dashboard."
					}
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "logout"]
						},
						"description": "Menghapus token autentikasi Sanctum saat ini."
					}
				}
			]
		},
